<mxfile>
  <diagram name="Motivation" id="motivation-1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title1" value="&lt;b&gt;Existing: Global Router Bias&lt;/b&gt;" style="text;html=1;fontSize=16;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- ===== LEFT SIDE: Global Bias ===== -->

        <!-- Harmful Query -->
        <mxCell id="q_harm" value="&lt;b&gt;&lt;font color='#cc0000'&gt;Harmful Query&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font size='1'&gt;&quot;How to make a bomb?&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#cc0000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="70" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- Benign Query -->
        <mxCell id="q_benign" value="&lt;b&gt;&lt;font color='#2e7d32'&gt;Benign Query&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font size='1'&gt;&quot;How to bake a cake?&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccffcc;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="460" y="70" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- Arrows down to router -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#cc0000;strokeWidth=2;" edge="1" source="q_harm" target="router_global" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2e7d32;strokeWidth=2;" edge="1" source="q_benign" target="router_global" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Router + Global Bias box -->
        <mxCell id="router_global" value="&lt;b&gt;MoE Router&lt;/b&gt;&lt;br&gt;+ Fixed Global Bias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="170" width="300" height="50" as="geometry"/>
        </mxCell>

        <!-- Global bias label -->
        <mxCell id="bias_label" value="&lt;font color='#ef6c00'&gt;&lt;b&gt;Same bias λ=1&lt;/b&gt;&lt;br&gt;for ALL queries&lt;/font&gt;" style="text;html=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="510" y="170" width="120" height="40" as="geometry"/>
        </mxCell>

        <!-- Expert boxes -->
        <mxCell id="e1" value="Expert 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#999;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="&lt;b&gt;Safety&lt;br&gt;Expert&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;strokeWidth=2;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="160" y="280" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="Expert 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#999;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="260" y="280" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="&lt;b&gt;Safety&lt;br&gt;Expert&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;strokeWidth=2;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="360" y="280" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="Expert 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#999;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="460" y="280" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="edots" value="..." style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="550" y="285" width="40" height="30" as="geometry"/>
        </mxCell>

        <!-- Arrows from router to experts -->
        <mxCell id="re1" style="strokeColor=#ef6c00;strokeWidth=1.5;" edge="1" source="router_global" target="e1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="re2" style="strokeColor=#ef6c00;strokeWidth=3;" edge="1" source="router_global" target="e2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="re3" style="strokeColor=#ef6c00;strokeWidth=1.5;" edge="1" source="router_global" target="e3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="re4" style="strokeColor=#ef6c00;strokeWidth=3;" edge="1" source="router_global" target="e4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="re5" style="strokeColor=#ef6c00;strokeWidth=1.5;" edge="1" source="router_global" target="e5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Consequence boxes -->
        <mxCell id="under" value="&lt;font color='#c62828'&gt;&lt;b&gt;Under-correction&lt;/b&gt;&lt;br&gt;Harmful query:&lt;br&gt;bias too weak → unsafe output&lt;br&gt;&lt;b&gt;Safety: 75%&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="over" value="&lt;font color='#2e7d32'&gt;&lt;b&gt;Over-correction&lt;/b&gt;&lt;br&gt;Benign query:&lt;br&gt;unnecessary bias → over-refusal&lt;br&gt;&lt;b&gt;Risk: capability loss&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="370" width="200" height="70" as="geometry"/>
        </mxCell>

        <!-- Problem statement -->
        <mxCell id="problem" value="&lt;b&gt;Core Problem:&lt;/b&gt; Query harmfulness varies, but global bias does not." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="470" width="460" height="35" as="geometry"/>
        </mxCell>

        <!-- ===== RIGHT SIDE: Bar chart placeholder ===== -->
        <mxCell id="title2" value="&lt;b&gt;(b) Empirical Evidence&lt;/b&gt;" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="780" y="20" width="300" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="chart_placeholder" value="&lt;i&gt;[Bar chart: L9 results]&lt;br&gt;No Defense: 33%&lt;br&gt;Global Bias: 75%&lt;br&gt;Per-Query (Ours): 99%&lt;br&gt;&lt;br&gt;n=100, p=1.6×10⁻⁷&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#ccc;strokeWidth=1;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="750" y="100" width="350" height="350" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
